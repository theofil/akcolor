            "cols": [4, 5, 6, 7],
            "labels": ["|SPVA[0]|", "|SPVA[1]|", "PVM[0]", "PVM[1]"]
        },
        "c": {
            "name": "combined",
            "cols": [0, 1, 2, 3, 4, 5, 6, 7],
            "labels": ["mjj", "|dYjj|", "|dPhijj|", "ptjj", "|SPVA[0]|", "|SPVA[1]|", "PVM[0]", "PVM[1]"]
        }
    }
}
