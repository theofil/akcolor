{
    "hidden_layers": [128, 64, 32],
    "dropout": 0.3,
    "batch_norm": true,
    "learning_rate": 0.001,
    "batch_size": 4096,
    "epochs": 200,
    "patience": 20,
    "mjj_cut": 400,
